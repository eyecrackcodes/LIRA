# Copy to .env.local and fill in. Nothing here is required to try the app —
# `npm run demo` runs the whole thing on generated data with no keys at all.

# ── Branding (cosmetic, safe to expose) ─────────────────────────────────────
NEXT_PUBLIC_BRAND_MARK=LIRA
NEXT_PUBLIC_BRAND_NAME=Franchise
NEXT_PUBLIC_BRAND_TAGLINE=Life Insurance Reporting Analytics

# ── Warehouse (Supabase Postgres) ───────────────────────────────────────────
# SERVER-ONLY. Never prefix these with NEXT_PUBLIC_ — until RLS is applied
# (supabase/rls-pay-tables.sql), a browser-visible key exposes every rep's pay.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=                    # anon key — used for Auth only
# SUPABASE_SERVICE_ROLE_KEY=     # preferred for data; REQUIRED once RLS is on

# ── Auth (Supabase Auth + Google) ───────────────────────────────────────────
# Managers see pay, P&L, costs, and admin pages. Reps are matched automatically
# against dim_agent.agent_email and see only their own scoped view.
MANAGER_EMAILS=                  # comma-separated
# DEPARTED_AGENTS=               # optional: comma-separated names to hide

# Local escape hatch: skip the login gate entirely (you browse as a manager).
# NEVER set this in production — it disables all access control.
# AUTH_DISABLED=1
# DEV_VIEWER_AGENT=              # browse as this rep instead, to check rep-scoped views

# ── Comp plan (see src/lib/config.ts) ───────────────────────────────────────
# MONTHLY_DRAW=4000              # payable = max(0, net − draw). 0 = no draw.
# MONTHLY_GOAL=50000             # per-rep monthly production goal

# ── Optional integrations ───────────────────────────────────────────────────
# "Ask Coach" chat — set ONE (Anthropic wins if both are set).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# COACH_MODEL=                   # default: claude-sonnet-5 / gpt-4o-mini

# Call-recording playback for the Film Room (see src/app/api/film/media).
# The reference implementation targets Attention (api.attention.tech); swap the
# fetch in that route for your own provider. Unset = play button returns 503,
# everything else on the page still works.
# ATTENTION_API_KEY=

# Live mailer figures from thanks.io. Unset = falls back to the warehouse
# snapshot. Delete the /mailer page entirely if you don't do direct mail.
# THANKS_API_KEY=

# Absolute origin, used for images in the weekly stack-rank email.
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# WEEKLY_EMAIL_TOKEN=            # lets cron GET /api/weekly-email?token=... headlessly
